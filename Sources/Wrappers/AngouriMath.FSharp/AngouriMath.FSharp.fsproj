<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)/../../Package.Build.props" />

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
	  <SignAssembly>true</SignAssembly>
	  <AssemblyOriginatorKeyFile>fsharp.key</AssemblyOriginatorKeyFile>
	  <Description>F# wrapper for some functions from AngouriMath. https://am.angouri.org/quickstart/index.html</Description>
	  <PackageTags>$(PackageTags), fsharp</PackageTags>
	  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Core.fs" />
    <Compile Include="Functions.fs" />
    <Compile Include="Compilation.fs" />
    <Compile Include="Constants.fs" />
    <Compile Include="Shortcuts.fs" />
    <Compile Include="Matrices.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- A notebook host runs its own FSharp.Core, so the wrappers ask for the lowest one they build
         against rather than the SDK's: 8.0.403 is Plotly.NET's floor, and 10.1 hung a C# kernel under a
         host carrying 10.0. https://github.com/asc-community/AngouriMath/issues/2108 -->
    <PackageReference Update="FSharp.Core" Version="8.0.403" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AngouriMath\AngouriMath.csproj" />
  </ItemGroup>

</Project>
