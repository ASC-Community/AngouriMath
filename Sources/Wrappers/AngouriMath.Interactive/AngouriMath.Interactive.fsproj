<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)/../../Package.Build.props" />
  
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Product>Wrapper of AngouriMath for Jupyter Interactive</Product>
    <Description>Wrapper of AngouriMath for Jupyter Interactive. https://am.angouri.org/</Description>
    <PackageTags>$(PackageTags), interactive, fsharp</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <NoWarn>
      $(NoWarn);
      NU5100 <!-- dll outside of lib/ folder --> ;
      FS0086 <!-- operators overrided --> ;
      NU5104 <!-- prerelease dependency--> 
    </NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Plot.fs" />
    <None Include="Repack.ps1" />
    
    <Compile Include="KernelExtension.fs" />
    <Compile Include="ArithmeticOperators.fs" />
    <Compile Include="AggressiveOperators.fs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="bin\**" />
    <EmbeddedResource Remove="bin\**" />
    <None Remove="bin\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AngouriMath.FSharp\AngouriMath.FSharp.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.DotNet.Interactive" Version="1.0.0-beta.23611.1" />
    <PackageReference Include="Microsoft.DotNet.Interactive.Formatting" Version="1.0.0-beta.23611.1" />
    <PackageReference Include="Plotly.NET" Version="6.0.0-preview.1" />
    <!-- A notebook host runs its own FSharp.Core, so the wrappers ask for the lowest one they build
         against rather than the SDK's: 8.0.403 is Plotly.NET's floor, and 10.1 hung a C# kernel under a
         host carrying 10.0. https://github.com/asc-community/AngouriMath/issues/2108 -->
    <PackageReference Update="FSharp.Core" Version="8.0.403" />
    <!-- Pinned to pull the patched build of a transitive dependency forward. Microsoft.DotNet.Interactive
         1.0.0-beta.23611.1 brings System.Text.Json 8.0.0, which has two high severity advisories (NU1903),
         GHSA-hh2w-p6rv-4g7w and GHSA-8g4q-xg66-9fp4; 8.0.6 is the patched build on the same major line.
         Not an upgrade of that package: the host supplies it, and building against a newer one than the
         host's is what hung a kernel through FSharp.Core, above. Remove this line once the
         Microsoft.DotNet.Interactive reference moves to a build whose own dependency is patched.
         https://github.com/asc-community/AngouriMath/issues/542 -->
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)/AngouriMath.Interactive.dll">
      <Pack>True</Pack>
      <PackagePath>interactive-extensions/dotnet</PackagePath>
    </None>
  </ItemGroup>
</Project>
