<Project Sdk="Microsoft.NET.Sdk">

  <!--
  The Model Context Protocol server that `amcli mcp` runs: newline-delimited JSON-RPC over stdio,
  exposing the library to an agent as tools, prompts and resources. A library rather than a
  program so that the terminal's tool is the one thing a user installs; Server.Run is the entry.
  It builds against the library in this repository, so a change to the parser or to an answer
  the server's selftest or its tests rely on fails here rather than after a release.
  https://github.com/asc-community/AngouriMath/issues/1649
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AngouriMath.Mcp</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Shipped inside the terminal's tool package, not as a package of its own. -->
    <IsPackable>false</IsPackable>
    <!-- Signed with the library's key, so that the library's InternalsVisibleTo can name it and
         the tools can answer from its internal catalogue of operations: a strong-named assembly
         may only befriend another strong-named one. It ships with the library it was built
         against, so it never meets another version's internals.
         https://github.com/asc-community/AngouriMath/issues/1684 -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../../AngouriMath/key.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Its tests are signed with the same key, which a signed assembly's friends have to be. -->
    <InternalsVisibleTo Include="McpUnitTests" Key="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../AngouriMath/AngouriMath.csproj" />
  </ItemGroup>

</Project>
