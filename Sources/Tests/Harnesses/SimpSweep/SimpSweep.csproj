<Project Sdk="Microsoft.NET.Sdk">

  <!--
  Does a simplification keep the value of the expression it came from, at sampled real points.
  A harness, not a test project: it is run by .github/workflows/Harnesses.yml and by hand,
  and `dotnet test` does not pick it up. See ../README.md.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>preview</LangVersion>
    <AssemblyName>simpsweep</AssemblyName>
    <RootNamespace>SimpSweep</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../AngouriMath/AngouriMath.csproj" />
  </ItemGroup>
</Project>
