<Project Sdk="Microsoft.NET.Sdk">

  <!--
  Modenov's computations as a corpus: the identities, equations and constants of Modenov's
  Problems in Geometry (Mir, 1981), each run and verified by value, and the book's errors as rows
  the library must not confirm. Reports solved / refused / unsolved / wrong / error / timeout and
  fails on a wrong answer or on a change to the committed verdicts, modenov-baseline.tsv.
  A harness, not a test project: it is run by .github/workflows/Harnesses.yml and by hand,
  and `dotnet test` does not pick it up. See ../README.md.
  https://github.com/asc-community/AngouriMath/issues/2153
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>preview</LangVersion>
    <AssemblyName>modenovcorpus</AssemblyName>
    <RootNamespace>ModenovCorpus</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../AngouriMath/AngouriMath.csproj" />
  </ItemGroup>
</Project>
